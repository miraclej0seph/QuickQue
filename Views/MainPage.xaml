<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuickQue.Views.MainPage">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Border
                Background="{StaticResource CafeVibrant}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0"
                Padding="20"
                Margin="0,0,0,10">

                <Label Text="QuickQueue"
                       TextColor="White"
                       FontSize="32"
                       HorizontalOptions="Center"
                       FontAttributes="Bold" />
            </Border>

            <!-- Input Card -->
            <Border>

                <VerticalStackLayout Spacing="15">

                    <Label Text="Select Café"
                           Style="{StaticResource SectionTitle}" />

                    <Border
                        Background="{StaticResource CafeCard}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12"
                        Margin="0,10">

                        <Grid ColumnDefinitions="*,Auto">

                            <Picker x:Name="CafePicker"
                                    Title="Select Café"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource CafeText}" />

                            <Label Text="▼"
                                   Grid.Column="1"
                                   TextColor="{StaticResource CafeText}"
                                   VerticalOptions="Center"
                                   Margin="10,0,0,0" />

                        </Grid>

                    </Border>

                    <Label Text="People waiting"
                           Style="{StaticResource SectionTitle}" />

                    <Entry x:Name="QueueEntry"
                           Placeholder="Enter number"
                           Keyboard="Numeric" />

                    <Button Text="Calculate"
                            Clicked="OnCalculateClicked" />

                    <Button Text="Reset"
                            BackgroundColor="{StaticResource CafeAccent}"
                            TextColor="White"
                            Clicked="OnResetClicked" />

                </VerticalStackLayout>

            </Border>

            <!-- Results Card -->
            <Border x:Name="ResultsCard">

                <VerticalStackLayout Spacing="10">

                    <Label x:Name="WaitTimeLabel" FontSize="20" />
                    <Label x:Name="StatusLabel" FontSize="20" />
                    <Label x:Name="RecommendationLabel" FontSize="18" />
                    <Label x:Name="CompletionTimeLabel" FontSize="18" />

                    <ProgressBar x:Name="QueueProgress" Progress="0" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
