<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuickQue.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="QuickQueue"
           FontSize="32"
           HorizontalOptions="Center"/>

            <Picker x:Name="CafePicker"
            Title="Select Café"/>

            <Entry x:Name="QueueEntry"
           Placeholder="People waiting"
           Keyboard="Numeric"/>

            <Button Text="Calculate"
            Clicked="OnCalculateClicked"/>

            <Button Text="Reset"
            Clicked="OnResetClicked"/>

            <Label x:Name="WaitTimeLabel"
           FontSize="20"/>

            <Label x:Name="StatusLabel"
           FontSize="20"/>

            <Label x:Name="RecommendationLabel"
           FontSize="18"/>

            <!-- Estimated Completion Time -->
            <Label x:Name="CompletionTimeLabel"
           FontSize="18"/>

            <!-- Progress Indicator -->
            <ProgressBar x:Name="QueueProgress"
                 Progress="0"
                 HeightRequest="10"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
